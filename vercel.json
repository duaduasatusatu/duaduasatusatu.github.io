{
  "version": 2,
  "builds": [{ "src": "**/*", "use": "@vercel/static" }, { "src": "api/auth.js", "use": "@vercel/node" }, { "src": "api/comments.js", "use": "@vercel/node" }],
  "routes": [{ "handle": "filesystem" }, { "src": "/api/auth", "dest": "/api/auth.js" }, { "src": "/api/comments", "dest": "/api/comments.js" }]
}